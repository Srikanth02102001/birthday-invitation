{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birthday-invitation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}